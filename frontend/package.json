{
    "name": "frontend",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "./node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "playwright test",
        "test:webauthn": "svelte-kit sync && node --test tests/webauthn-auth.node.mjs",
        "test:redirect-uri": "svelte-kit sync && node --test tests/redirect-uri.node.mjs",
        "test:password-reset": "npm run build && node --test tests/password-reset.node.mjs",
        "test:new-user-passkey": "npm run build && node --test tests/new-user-passkey.node.mjs",
        "test:split-login": "npm run build && node --test tests/split-login.node.mjs",
        "test:shared-device": "npm run build && node --test tests/shared-device.node.mjs",
        "lint": "prettier --check . && eslint .",
        "format": "./node_modules/prettier/bin/prettier.cjs --write .",
        "format-check": "./node_modules/prettier/bin/prettier.cjs -c ."
    },
    "devDependencies": {
        "@internationalized/date": "^3.5.5",
        "@playwright/test": "^1.25.0",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@types/node": "^25.9.0",
        "base64-arraybuffer": "^1.0.2",
        "eslint": "^10.0.1",
        "eslint-config-prettier": "^10.0.2",
        "eslint-plugin-svelte": "^3.0.2",
        "prettier": "^3.1.0",
        "prettier-plugin-svelte": "^3.2.6",
        "svelte": "^5.57.1",
        "svelte-check": "^4.3.4",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-wasm": "^3.4.1"
    },
    "type": "module"
}
